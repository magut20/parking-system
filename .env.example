# Copy this file to .env and fill in real values. Never commit .env itself.

# Connection driver: "mysql" or "sqlite"
DB_CONNECTION=sqlite

# --- Used when DB_CONNECTION=mysql ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=parking
DB_USER=root
DB_PASS=

# --- Used when DB_CONNECTION=sqlite ---
DB_SQLITE_PATH=database/parking.sqlite

# Number of parking slots to seed on first run
NUM_SLOTS=20

# Hours after which an unclaimed booking auto-expires (0 = never)
BOOKING_EXPIRY_HOURS=24

# App environment: "local" or "production". Controls error display.
APP_ENV=local
